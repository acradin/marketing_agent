VE_DATABASE_URL=sqlite:///./data/viral.db
VE_LLM_BASE_URL=https://api.openai.com/v1
VE_LLM_API_KEY=
VE_LLM_MODEL=gpt-4.1-mini
VE_REDDIT_TOKEN=
VE_REDDIT_USER_AGENT=viral-engine/0.1 (configure contact)
VE_YOUTUBE_API_KEY=
# Enable only after confirming permission for the URLs you supply.
VE_ALLOW_PUBLIC_URLS=false
# Publishing is off until explicitly configured. No automatic publication.
VE_ENABLE_PUBLISHING=false
VE_REDDIT_SUBREDDIT=

# X collection: bearer token; publishing: OAuth 1.0a Read and Write credentials.
VE_X_BEARER_TOKEN=
VE_X_API_KEY=
VE_X_API_SECRET=
VE_X_ACCESS_TOKEN=
VE_X_ACCESS_TOKEN_SECRET=
VE_X_USER_ID=
# Instagram Graph API with FACEBOOK LOGIN (not Instagram Login).
VE_INSTAGRAM_TOKEN=
VE_INSTAGRAM_USER_ID=
VE_INSTAGRAM_API_VERSION=v24.0

# For Liner: base URL https://platform.liner.com/api/v1, model liner-mark, key in VE_LLM_API_KEY.
# Set false if the provider rejects response_format; local validation still applies.
VE_LLM_JSON_MODE=true
